\contentsline {figure}{\numberline {3.1}{\ignorespaces Przekrój głowicy optyczno-elektronicznej prezentujący odwróconą architekturę systemową oraz rozmieszczenie kluczowych komponentów obliczeniowych i zasilania.\relax }}{23}{figure.caption.26}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Model jarzma wsporczego (Moduł II) zapewniającego sztywność skrętną osi poziomej.\relax }}{24}{figure.caption.27}%
