\contentsline {figure}{\numberline {3.1}{\ignorespaces Przekrój głowicy optyczno-elektronicznej zaprojektowanej w środowisku Inventor 2026, prezentujący architekturę systemową oraz rozmieszczenie komponentów obliczeniowych i zasilania.\relax }}{22}{figure.caption.16}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Model jarzma wsporczego (Moduł II) zapewniającego sztywność skrętną osi poziomej.\relax }}{24}{figure.caption.17}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Zewnętrzny model ruchomej czaszy (Moduł III) ze zintegrowanym wieńcem napędowym osi TILT.\relax }}{24}{figure.caption.17}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Widok boczny kompletnego modelu przestrzennego demonstratora układu nadążnego.\relax }}{24}{figure.caption.18}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Widok tylny zespołu głowicy, obrazujący umiejscowienie napędów krokowych.\relax }}{24}{figure.caption.18}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Przekrój czaszy głowicy uwidaczniający wewnętrzne półki montażowe, zaprojektowane w celu wyważenia układu.\relax }}{25}{figure.caption.19}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Model przekładni o zębach daszkowych osi PAN oraz TILT.\relax }}{26}{figure.caption.20}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Gotowy model demonstratora\relax }}{27}{figure.caption.21}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Schemat ideowy układu zasilania uwzględniający pakiet ogniw 4S oraz przetwornice napięcia.\relax }}{30}{figure.caption.22}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Architektura połączeń jednostki nadrzędnej (Raspberry Pi) z układem wykonawczym (ESP32).\relax }}{31}{figure.caption.23}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces Układ wykonawczy napędów PAN/TILT z wykorzystaniem sterowników Pololu 36v4 i komunikacji SPI.\relax }}{32}{figure.caption.24}%
\contentsline {figure}{\numberline {3.12}{\ignorespaces Schemat elektryczny układu kluczującego moduł lasera za pomocą tranzystora NPN.\relax }}{33}{figure.caption.25}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Model symulacyjny układu wykonawczego umieszczony w środowisku Gazebo. W tle widoczny jest wirtualny obiekt referencyjny (sfera) poruszający się po zadanej trajektorii elipsy.\relax }}{41}{figure.caption.26}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Interfejs nakładki diagnostycznej w trybie samouczenia w środowisku symulacyjnym Gazebo. Zrzut ekranu prezentuje 3 epokę uczenia, wyliczone na żywo kąty PAN/TILT oraz aktualne wartości nastaw regulatora PID weryfikowane na wykrytym i ograniczonym ramką obiekcie referencyjnym.\relax }}{44}{figure.caption.27}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Wizualizacja interfejsu GUI. Od góry odebrana klatka obrazu z nałożonymi znacznikami obszaru śledzenia (niebieska ramka), środka ciężkości wg estymatora Kalmana (czerwony punkt) oraz środka kamery (zielony krzyż). Poniżej widoczna jest maska binarna, która służy do kalibracji warunków oświetleniowych.\relax }}{50}{figure.caption.28}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Odpowiedź skokowa układu w otwartej pętli.\relax }}{54}{figure.caption.30}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Fizyczne stanowisko laboratoryjne z wyznaczoną strefą pomiarową oraz obiektem referencyjnym (żółta piłka o średnicy 23 cm) używanym podczas testów.\relax }}{60}{figure.caption.34}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Porównanie odpowiedzi skokowej regulatora PD dla dystansu 80~cm.\relax }}{61}{figure.caption.35}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Porównanie odpowiedzi skokowej regulatora PD dla dystansu 30~cm.\relax }}{62}{figure.caption.36}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Porównanie odpowiedzi skokowej regulatora PD dla dystansu 150~cm.\relax }}{63}{figure.caption.37}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Śledzenie ruchu eliptycznego dla dystansu 80~cm (PD).\relax }}{64}{figure.caption.38}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Śledzenie ruchu eliptycznego dla dystansu 30~cm (PD).\relax }}{64}{figure.caption.39}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces Śledzenie ruchu eliptycznego dla dystansu 150~cm (PD).\relax }}{65}{figure.caption.40}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Porównanie odpowiedzi układów podczas oddalania celu (30 -- 150~cm).\relax }}{66}{figure.caption.41}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Porównanie odpowiedzi skokowej regulatora trójstawnego na dystansie 80~cm.\relax }}{67}{figure.caption.42}%
\contentsline {figure}{\numberline {6.10}{\ignorespaces Porównanie odpowiedzi skokowej regulatora trójstawnego na dystansie 30~cm.\relax }}{68}{figure.caption.43}%
\contentsline {figure}{\numberline {6.11}{\ignorespaces Porównanie odpowiedzi skokowej regulatora trójstawnego na dystansie 150~cm.\relax }}{68}{figure.caption.44}%
\contentsline {figure}{\numberline {6.12}{\ignorespaces Śledzenie ruchu eliptycznego dla dystansu 80~cm (Regulator trójstawny).\relax }}{69}{figure.caption.45}%
\contentsline {figure}{\numberline {6.13}{\ignorespaces Śledzenie ruchu eliptycznego dla dystansu 30~cm (Regulator trójstawny) -- identyczna odpowiedź wynikająca z nasycenia układu wykonawczego.\relax }}{70}{figure.caption.46}%
\contentsline {figure}{\numberline {6.14}{\ignorespaces Śledzenie ruchu eliptycznego dla dystansu 150~cm (Regulator trójstawny).\relax }}{70}{figure.caption.47}%
\contentsline {figure}{\numberline {6.15}{\ignorespaces Płynne oddalanie obiektu w zakresie 30 -- 150~cm (Regulator trójstawny).\relax }}{72}{figure.caption.48}%
\contentsline {figure}{\numberline {6.16}{\ignorespaces Kadr podczas testów polowych. Widoczny dron przenoszący obiekt testowy na tle infrastruktury i roślinności, oddalony o około 13 metrów od obiektywu.\relax }}{74}{figure.caption.50}%
\contentsline {figure}{\numberline {6.17}{\ignorespaces Zapis uchybu śledzenia w środowisku polowym (Regulator PD, nastawy analityczne). Widoczne szybkie nadążanie za dronem oraz incydent zgubienia celu z udaną re-akwizycją.\relax }}{75}{figure.caption.51}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {7.1}{\ignorespaces Przykłady problemów detekcyjnych w warunkach polowych przy zmiennym oświetleniu i niskim kontraście.\relax }}{79}{figure.caption.52}%
